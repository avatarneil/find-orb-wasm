{
  "name": "find-orb-wasm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later",
  "description": "Pinned Find_Orb WebAssembly build and isolated worker runtime",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "build",
    "README.md",
    "LICENSE",
    "EMSCRIPTEN-LICENSE.txt",
    "licenses",
    "NOTICE",
    "provenance.json",
    "data"
  ],
  "scripts": {
    "build": "node build/build.mjs",
    "build:native": "node build/native.mjs",
    "data:compact": "node data/compact.mjs",
    "test": "node --test tests/build/*.test.mjs tests/runtime/*.test.mjs tests/accuracy/*.test.mjs tests/data/*.test.mjs",
    "test:runtime": "node --test tests/runtime/*.test.mjs",
    "test:accuracy": "node --test tests/accuracy/*.test.mjs",
    "test:data": "node --test tests/data/*.test.mjs",
    "test:browser": "playwright test",
    "benchmark": "node benchmark/run.mjs",
    "verify:proofs": ".venv/verification/bin/python verification/prove.py",
    "verify:compiler": ".venv/verification/bin/python verification/compiler_checks.py",
    "setup:proof-tools": ".venv/research/bin/python verification/kernel/bootstrap.py",
    "verify:research": ".venv/research/bin/python verification/research.py",
    "verify:kernel": ".venv/research/bin/python verification/kernel/check.py",
    "verify:source": "node scripts/verify-source-rebuild.mjs",
    "report:research": "node scripts/research-report.mjs",
    "verify:data": "node data/verify-native.mjs && node data/verify-wasm.mjs && node data/report.mjs",
    "verify:experimental": ".venv/verification/bin/python verification/prove_wide_multiply.py && node verification/check-wide-multiply.mjs && node benchmark/check-quad.mjs",
    "benchmark:paired": "node benchmark/paired.mjs",
    "report": "node scripts/report.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1"
  }
}
